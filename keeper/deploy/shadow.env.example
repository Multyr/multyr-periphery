# SHADOW / local — plain key, no KMS. Never use for production funds.
# Copy to shadow.env (git-ignored).

KEEPER_INSTANCE=primary
KEEPER_CONFIG=config/arbitrum-one.json
RPC_URLS=https://arb1.arbitrum.io/rpc

SIGNER=local
KEEPER_PRIVATE_KEY=0x...
# For `check` / `preflight` without a signer (SIGNER unset), simulate as this address instead:
# KEEPER_ADDRESS=0x...

ALERT_WEBHOOK_URL=
LOG_LEVEL=info
# Optional: limit to a subset of jobs, e.g. JOBS=W5,W6.
# JOBS=
