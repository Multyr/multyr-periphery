# FORK TESTS — scripts/pdf-cycle.ts and scripts/keeper-cycle.ts (local Anvil only).
# Copy to fork-test.env (git-ignored). No keys: the scripts use an ephemeral local wallet.

# Archive RPC, read-only. Must serve historical state at block 509739747.
SOURCE_RPC_URL=https://arbitrum-mainnet.infura.io/v3/KEY
# Local Anvil forked at 509739747; must be a loopback URL.
FORK_RPC_URL=http://127.0.0.1:18545

# Optional report paths (defaults shown).
# CYCLE_REPORT=pdf-cycle-report.json
# KEEPER_CYCLE_REPORT=keeper-cycle-report.json
# Optional: reuse a completed baseline instead of re-running it.
# KEEPER_BASELINE_REPORT=keeper-baseline-report.json

# Only if Node reports UNABLE_TO_GET_ISSUER_CERT_LOCALLY (macOS host CA bundle):
# NODE_EXTRA_CA_CERTS=/private/etc/ssl/cert.pem
